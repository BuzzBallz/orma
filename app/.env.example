# The only variable the frontend reads. No secret belongs in here: everything under
# VITE_ is inlined into the bundle and shipped to every visitor.
#
# Unset  -> http://localhost:8787, which is right on a laptop and impossible from a
#           deployed preview. On an https page the app detects that, stops polling
#           entirely and says so on screen instead of hammering an address nobody
#           is listening on. See API_MIXED_ORIGIN in src/lib/api.ts.
# Set    -> must be https on a deployed preview, or the browser blocks it as mixed
#           content before the request leaves the tab.
VITE_API_BASE=https://your-api.example.com

# The XRPL network the wallet side is pointed at: mainnet | testnet | devnet.
# Configuration, not a reading — it is never taken from an API response.
VITE_XRPL_NETWORK=devnet

# Xaman sign-in QR. Optional: leave it out and Crossmark and GemWallet still work,
# the Xaman row just says it has no key. This is a public app key, not a secret —
# but nothing that IS a secret may ever live in a VITE_ variable.
# VITE_XAMAN_API_KEY=

# Where the "Docs" link in the header points. Unset -> https://ormaprotocol.mintlify.site/
# Set it to a local build (http://localhost:4173) when editing the documentation.
# VITE_DOCS_URL=
