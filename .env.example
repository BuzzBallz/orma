# Every variable the backend reads. Copy to .env, which src/index.mjs loads at startup; a variable
# already set in the shell wins. All are optional, and commented ones have no default: the defaults run
# the demo against Devnet.

# --- the API and the reader (src/index.mjs) ---
PORT=8787
XRPL_WS=wss://s.devnet.rippletest.net:51233
# Vault ids to serve, comma-separated. Unset: the facilities baked into demo/.
# VAULTS=
POLL_MS=4000
# Accounts scanned for escrowed share collateral, comma-separated.
# WATCH_ACCOUNTS=
# The rater the gate route checks for. Unset: read from demo/gate-vault.json.
# RATER_ADDRESS=
# Lets /api/demo/* POSTs from a non-loopback address that send it as x-demo-key.
# DEMO_KEY=
LOG_LEVEL=info
LOG_PRETTY=0

# --- on-ledger publication of the score as XLS-47 Oracle objects (off unless one is set) ---
# Publish from this account. Never commit it.
# PUBLISH_SEED=
# PUBLISH=faucet funds a throwaway publisher on Devnet instead.
# PUBLISH=
PUBLISH_HEARTBEAT_MS=60000

# --- demo and dev scripts (src/demo, src/dev) ---
# Base URL baked into a new share's nav pointer. Immutable once minted: use a permanent https host.
PUBLIC_BASE=http://localhost:8787
API_BASE=http://localhost:8787
ORMA_API=http://localhost:8787
XRPL_RPC=https://s.devnet.rippletest.net:51234
GATE_SUBSCRIPTION_SECONDS=900
# SECOND_PUBLISHER=
